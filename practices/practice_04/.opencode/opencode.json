{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "plugin": [
    "./plugins/auto-verify.js"
  ],
  "mcp": {
    "sudoku": {
      "type": "local",
      "command": ["python3", "mcp/sudoku/index.py"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {"*": "ask"},
    "skill": "allow"
  }
}
